# Safe default. Production trading must remain opt-in and double-gated.
BINANCE_ENV=testnet
ENABLE_LIVE_TRADING=false
BINANCE_RUN_PUBLIC_TESTNET=false
BINANCE_RUN_SIGNED_TESTNET=false
BINANCE_RUN_PUBLIC_WEBSOCKET_TESTNET=false
BINANCE_RUN_SIGNED_WEBSOCKET_TESTNET=false
BINANCE_RUN_USER_STREAM_EVENTS_TESTNET=false
BINANCE_RUN_WEBSOCKET_RESTORE_TESTNET=false

# Leave credentials empty in source control. Copy this file to .env locally.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ED25519_PRIVATE_KEY_PATH=
